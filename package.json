{
  "name": "siska",
  "version": "1.0.0",
  "private": true,
  "description": "SISKA (Sistem Pengaduan Kekerasan Seksual) \u2014 Next.js App Router + Firebase Backend & Emulator Seeder",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./src/tests/ts-alias-loader.mjs --test src/tests/unit/backend-test-plan.test.mjs src/tests/unit/ai-reply.test.mjs src/tests/unit/ai-pdf-extractor.test.mjs src/tests/unit/education-notification.test.mjs src/tests/unit/authz-canonical-fields.test.mjs",
    "seed:dry": "node seed.mjs --dry-run",
    "seed": "node seed.mjs --emulator",
    "seed:reset": "node seed.mjs --emulator --reset",
    "seed:adversarial": "node seed.mjs --emulator --reset --with-adversarial",
    "seed:clean": "node seed.mjs --emulator --reset-only",
    "test:ai-service": "npm --prefix ai-service test",
    "test:rules:firestore": "firebase emulators:exec --only firestore --project demo-siska-firestore-rules \"node --test src/tests/rules/firestore.rules.test.mjs\"",
    "test:rules:storage": "firebase emulators:exec --only storage --project demo-siska-storage-rules \"node --test src/tests/rules/storage.rules.test.mjs\"",
    "test:rules": "npm run test:rules:firestore && npm run test:rules:storage",
    "test:idor": "node scripts/idor-check.mjs",
    "test:backend": "node --experimental-strip-types --import ./src/tests/ts-alias-loader.mjs --test src/tests/unit/backend-test-plan.test.mjs"
  },
  "dependencies": {
    "firebase": "^11.8.1",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^0.510.0",
    "next": "15.3.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@firebase/rules-unit-testing": "^4.0.1"
  }
}
