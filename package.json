{
  "name": "siska-firebase-seed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seed sintetis Firebase (Auth, Firestore, Storage) untuk SISKA — mengikuti SISKA-SRS-Engineering-Spec",
  "scripts": {
    "seed:dry": "node seed.mjs --dry-run",
    "seed": "node seed.mjs --emulator",
    "seed:reset": "node seed.mjs --emulator --reset",
    "seed:adversarial": "node seed.mjs --emulator --reset --with-adversarial",
    "seed:clean": "node seed.mjs --emulator --reset-only"
  },
  "engines": { "node": ">=18" },
  "dependencies": { "firebase-admin": "^13.0.0" }
}
