# ============================================================================
# SISKA — Konfigurasi Environment (Placeholder)
# Salin berkas ini menjadi `.env.local` untuk pengembangan lokal.
# JANGAN pernah melakukan commit berkas `.env.local` atau secret asli ke Git!
# ============================================================================

# ── 1. Firebase Web Client SDK (Publik / Browser) ──────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourPlaceholderApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="demo-siska.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="demo-siska"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="demo-siska.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:placeholder"

# Set ke "true" saat menggunakan Firebase Emulator Suite di sisi client
NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"

# ── 2. Firebase Admin SDK (HANYA Server — Rahasia) ─────────────────────────
FIREBASE_PROJECT_ID="demo-siska"
FIREBASE_STORAGE_BUCKET="demo-siska.appspot.com"

# Kredensial Service Account (Hanya untuk Staging/Production, kosongkan saat memakai Emulator)
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ── 3. Firebase Emulator Suite (Pengembangan Lokal) ────────────────────────
# Sesuai dengan firebase.json.example
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

# ── 4. SISKA AI Service (FastAPI RAG Microservice) ─────────────────────────
# Set AI_SERVICE_ENABLE_REMOTE="true" apabila microservice FastAPI eksternal dijalankan
AI_SERVICE_ENABLE_REMOTE="false"
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_SHARED_SECRET="placeholder-replace-in-staging-or-prod"
AI_SERVICE_TIMEOUT_MS="10000"
