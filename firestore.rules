rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Identitas dan role
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    // Role yang valid pada Custom Claims adalah otoritas utama.
    function hasValidRoleClaim() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'reporter' ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'admin';
    }

    // Konsisten dengan verifyBearerToken(): profil hanya menjadi fallback
    // reporter jika token belum memiliki claim role SISKA yang valid.
    // Claim admin tidak pernah diturunkan menjadi reporter melalui profil.
    function isReporter() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'reporter' ||
        (
          !hasValidRoleClaim() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'reporter'
        )
      );
    }

    // ------------------------------------------------------------------
    // Akses baca percakapan
    // ------------------------------------------------------------------
    // reporterId dan assignedAdminId adalah field kanonis.
    // reporterUid/adminUid hanya fallback untuk dokumen legacy jika field
    // kanonis sama sekali tidak ada. Alias yang berkonflik tidak memberi akses.
    function isConversationReporter(convData) {
      return isReporter() && (
        (
          convData.keys().hasAny(['reporterId']) &&
          convData.get('reporterId', '') == request.auth.uid
        ) ||
        (
          !convData.keys().hasAny(['reporterId']) &&
          convData.get('reporterUid', '') == request.auth.uid
        )
      );
    }

    function isAssignedAdmin(convData) {
      return isAdmin() && (
        (
          convData.keys().hasAny(['assignedAdminId']) &&
          convData.get('assignedAdminId', null) == request.auth.uid
        ) ||
        (
          !convData.keys().hasAny(['assignedAdminId']) &&
          convData.get('adminUid', null) == request.auth.uid
        )
      );
    }

    function isUnassignedConversation(convData) {
      return (
        (
          convData.keys().hasAny(['assignedAdminId']) &&
          (
            convData.get('assignedAdminId', null) == null ||
            convData.get('assignedAdminId', null) == ''
          )
        ) ||
        (
          !convData.keys().hasAny(['assignedAdminId']) &&
          (
            convData.get('adminUid', null) == null ||
            convData.get('adminUid', null) == ''
          )
        )
      );
    }

    function isConversationParticipant(convData) {
      return signedIn() && (
        isConversationReporter(convData) ||
        (
          isAdmin() &&
          (isAssignedAdmin(convData) || isUnassignedConversation(convData))
        )
      );
    }

    // Kepemilikan laporan untuk pembacaan metadata subkoleksi.
    function isReportOwner(reportId) {
      return isReporter() &&
        exists(/databases/$(database)/documents/reports/$(reportId)) &&
        get(/databases/$(database)/documents/reports/$(reportId)).data.get('reporterId', '') == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{uid} {
      // Get satu profil: pemilik sendiri atau admin. Listing profil massal
      // dari Client SDK ditutup; kebutuhan operasional melalui backend.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if false;

      // Semua mutasi profil/provisioning melewati API + Firebase Admin SDK.
      // Client tidak boleh mengubah role, email, UID, maupun metadata sistem.
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // reports/{reportId}
    // ------------------------------------------------------------------
    match /reports/{reportId} {
      // Kebijakan saat ini: reporter hanya membaca miliknya; admin dengan
      // Custom Claim admin dapat membaca semua laporan. Cakupan admin menjadi
      // keputusan kebijakan SEC-F03 dan harus disetujui tim sebelum produksi.
      allow get, list: if isAdmin() ||
        (isReporter() && resource.data.get('reporterId', '') == request.auth.uid);

      // Pembuatan/perubahan/penghapusan hanya melalui ReportService. Service
      // mengatur validasi, transaksi statusHistory, serta auditEvents.
      allow create, update, delete: if false;

      match /evidence/{evidenceId} {
        allow get, list: if isAdmin() || isReportOwner(reportId);
        allow create, update, delete: if false;
      }

      match /statusHistory/{eventId} {
        allow get, list: if isAdmin() || isReportOwner(reportId);
        allow create, update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // conversations/{conversationId} dan messages
    // ------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow get, list: if isConversationParticipant(resource.data);

      // Buat, assign/claim admin, close/reopen, dan perubahan lain dilakukan
      // oleh ConversationService melalui API + Admin SDK dalam transaksi.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        );

        // Pengiriman pesan harus melalui API agar pemeriksaan mode 'send',
        // rate limit, sender dari token, status, claim admin, transaksi dan
        // audit backend tidak dapat dilewati oleh Client SDK.
        allow create, update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Knowledge Base dan audit
    // ------------------------------------------------------------------
    match /knowledgeDocuments/{documentId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /knowledgeChunks/{chunkId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /auditEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Default-deny untuk seluruh koleksi/path Firestore yang tidak disebut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
