rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isReporter() {
      return signedIn() && (
        request.auth.token.role == 'reporter' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reporter')
      );
    }

    function isReportOwner(reportId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/reports/$(reportId)) &&
        get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid;
    }

    function isConversationParticipant(convData) {
      return signedIn() && (
        convData.get('reporterId', '') == request.auth.uid ||
        convData.get('reporterUid', '') == request.auth.uid ||
        (isAdmin() && (
          convData.get('assignedAdminId', null) == request.auth.uid ||
          convData.get('adminUid', null) == request.auth.uid ||
          (convData.get('assignedAdminId', null) == null && convData.get('adminUid', null) == null)
        ))
      );
    }

    // users
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'reporter'
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt']);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'createdAt', 'updatedAt']);
      allow delete: if false;

      // notifications
      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
        allow create, delete: if false;
      }
    }

    // reports
    match /reports/{reportId} {
      allow create: if isReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 1
        && request.resource.data.category.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 20000
        && request.resource.data.keys().hasOnly([
          'reporterId', 'category', 'incidentAt', 'location',
          'description', 'status', 'createdAt', 'updatedAt', 'resolvedAt'
        ]);
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if false;

      // evidence
      match /evidence/{evidenceId} {
        allow read: if isReportOwner(reportId) || isAdmin();
        allow create, update, delete: if false;
      }

      // statusHistory
      match /statusHistory/{eventId} {
        allow read: if isReportOwner(reportId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // conversations
    match /conversations/{conversationId} {
      allow read: if isConversationParticipant(resource.data);
      allow create: if isReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.type == 'report_admin'
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'type', 'reporterId', 'assignedAdminId', 'reportId', 'status', 'createdAt', 'updatedAt'
        ]);
      allow update, delete: if false;

      // messages
      match /messages/{messageId} {
        allow read: if isConversationParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        );
        allow create: if isConversationParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          )
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'open'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 10000
          && request.resource.data.keys().hasOnly(['senderUid', 'body', 'createdAt', 'attachmentPath']);
        allow update, delete: if false;
      }
    }

    // knowledgeDocuments
    match /knowledgeDocuments/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // knowledgeChunks
    match /knowledgeChunks/{chunkId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // auditEvents
    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // education
    match /education/{articleId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if false;
    }

    // default-deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
