rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isReportOwner(reportId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/reports/$(reportId)) &&
        firestore.get(/databases/(default)/documents/reports/$(reportId)).data.reporterId == request.auth.uid;
    }

    function isAllowedEvidenceMime() {
      return request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'image/jpeg' ||
        request.resource.contentType == 'image/png';
    }

    // evidence
    match /reports/{reportId}/evidence/{fileName} {
      allow read: if isAdmin() || isReportOwner(reportId);
      allow create: if isReportOwner(reportId)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && isAllowedEvidenceMime();
      allow update, delete: if false;
    }

    // knowledge-base
    match /knowledge-base/{docId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    // default-deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
