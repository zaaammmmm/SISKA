rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){ return request.auth != null; }
  function isAdmin(){ return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
  match /evidences/{reportId}/{fileName} { allow read: if signedIn() && (isAdmin() || firestore.get(/databases/(default)/documents/reports/$(reportId)).data.reporterId == request.auth.uid); allow create: if signedIn() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*|application/pdf') && firestore.get(/databases/(default)/documents/reports/$(reportId)).data.reporterId == request.auth.uid; allow update, delete: if false; }
  match /knowledge-base/{fileName} { allow read, write: if isAdmin() && request.resource.size < 25 * 1024 * 1024 && request.resource.contentType == 'application/pdf'; }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
