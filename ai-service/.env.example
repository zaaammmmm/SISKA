# Salin menjadi `.env` (berkas .env diabaikan git). Tidak perlu npm install.

# ── Server ──────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# Secret server-to-server. HARUS SAMA dengan AI_SERVICE_SHARED_SECRET di .env.local SISKA.
# Bila kosong, layanan menolak semua request /chat dan /admin.
AI_SERVICE_SHARED_SECRET=ganti-dengan-secret-acak-panjang
# Hanya untuk uji lokal tanpa secret (jangan dipakai di server):
# ALLOW_NO_AUTH=true

# ── Ollama ──────────────────────────────────────────────
# Backend aktif: local | colab (bisa diubah saat jalan lewat POST /admin/settings)
OLLAMA_BACKEND=local
OLLAMA_LOCAL_URL=http://localhost:11434
# Isi bila OLLAMA_BACKEND=colab (URL tunnel cloudflared/ngrok)
OLLAMA_COLAB_URL=

# Nama model embed HARUS sama persis dengan yang dipakai di notebook.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_CHAT_MODEL=qwen3:4b-instruct

LLM_TEMPERATURE=0
LLM_SEED=42
LLM_NUM_CTX=6144
LLM_MAX_NEW_TOKENS=350

# ── Dokumen yang diunggah lewat /admin/rag-docs ─────────
CHUNK_CHARS=900
CHUNK_MIN=200

# ── Riwayat percakapan (memori) ─────────────────────────
SESSION_MAX=500
SESSION_TTL_MIN=60
